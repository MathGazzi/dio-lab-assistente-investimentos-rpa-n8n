      "name": "Sticky Note1"
    },
    {
      "parameters": {
        "jsCode": "// 1. Pega os clientes do Split Out\nconst clientes = $('Split Out').all();\n\n// 2. Pega os investimentos do Extract from File\nconst investimentos = $('Extract from File').all();\n\n// 3. Monta a lista final com as mensagens estáticas da Etapa 4 (MVP)\nreturn clientes.map(itemCliente => {\n  const cliente = itemCliente.json;\n  \n  // Encontra o investimento do perfil\n  const investComp = investimentos.find(inv => \n    inv.json.perfil && cliente.perfil && \n    inv.json.perfil.toLowerCase() === cliente.perfil.toLowerCase()\n  );\n\n  const produto = investComp ? investComp.json.produto : \"Poupança\";\n  const rentabilidade = investComp ? investComp.json.rentabilidade : \"6.2%\";\n  \n  // Templates fixos baseados no perfil (exatamente o que a DIO pediu)\n  let textoEstrategia = \"\";\n  if (cliente.perfil.toLowerCase() === \"conservador\") {\n    textoEstrategia = \"Recomendamos foco em renda fixa e segurança.\";\n  } else if (cliente.perfil.toLowerCase() === \"moderado\") {\n    textoEstrategia = \"Recomendamos um mix equilibrado entre renda fixa e variável.\";\n  } else {\n    textoEstrategia = \"Recomendamos ênfase em ações e maior potencial de retorno.\";\n  }\n\n  const mensagemFinal = `Olá ${cliente.nome.split(' ')[0]}! Seu saldo é ${cliente.saldo} e seu perfil é ${cliente.perfil}. ${textoEstrategia} Sugestão de produto: ${produto} (${rentabilidade}).`;\n\n  return {\n    json: {\n      nome: cliente.nome,\n      email: cliente.email,\n      saldo: cliente.saldo,\n      perfil: cliente.perfil,\n      produto: produto,\n      rentabilidade: rentabilidade,\n      mensagem: mensagemFinal\n    }\n  };\n});"
      },
